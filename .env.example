# Django Virtual Lab - Environment Configuration Template
# Copy this file to .env and adjust values as needed

# Django Core Settings
SECRET_KEY=django-insecure-change-this-in-production-random-50-character-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Optional: Remote PostgreSQL for persistent feedback storage (e.g. Neon, Supabase)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
